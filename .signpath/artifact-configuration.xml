<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="CodexBar-${version}-Setup.exe">
      <authenticode-sign description="CodexBar ${version}" description-url="https://github.com/nesszer/Win-CodexBar/releases" />
    </pe-file>
    <pe-file path="CodexBar-${version}-portable.exe">
      <authenticode-sign description="CodexBar ${version} (portable)" description-url="https://github.com/nesszer/Win-CodexBar/releases" />
    </pe-file>
  </zip-file>
</artifact-configuration>
